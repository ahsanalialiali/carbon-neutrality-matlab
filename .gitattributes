# Default text handling
* text=auto

# MATLAB source code
*.m text eol=lf
*.mlx binary
*.mat binary
*.fig binary
*.slx binary

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration and datasets
*.json text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.prj text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Images and reports
*.png binary
*.jpg binary
*.pdf binary
